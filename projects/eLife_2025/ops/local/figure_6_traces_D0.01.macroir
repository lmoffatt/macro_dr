par_100_1 = create_parameters(model = model, parameters_info = [{"on","Log10",10},{"off","Log10",100},{"unitary_current","Log10",1},{"Current_Noise","Log10",0.01},{"Current_Baseline","Log10",1},{"Num_ch_mean","Log10",100}])
