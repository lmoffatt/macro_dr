# figure_1_evidence.macroir — paired evidence for one Figure 1 replica:
# fits BOTH models (scheme_CCO and scheme_COC) to the SAME recording, so the
# per-replica Delta logZ is paired and the shared dataset noise cancels.
#
# Uses the inline-Experiment overload of thermo_evidence_dts (2026-09-04):
# the experiment object flows straight in, so the dispatcher can sweep the
# protocol via injected segments, exactly like the eLife figure lanes.
# Likelihood member: the canonical IR of the paper (post 2026-09-02 retarget:
# adaptive=0, recursive=1, averaging=2, variance_approximation=1,
# variance_correction_approximation=0). Any other combo fails at runtime by
# domain check.
#
# FILE CONTRACT — this script must NOT define the injected names:
#   exp_n_step_1, exp_n_step_2, exp_n_step_3, exp_n_samp, agonist_2, agonist_3
#       (MUST match the segments the recording was simulated with)
#   observations_file        (absolute path to the, possibly nan-masked, recording csv)
#   prior_cco_file, prior_coc_file   (absolute paths; COC prior = twin-centered)
#   idname_cco, idname_coc   (unique per job and fit)
#   num_scouts               (walkers per rung)
#   beta_size                (INITIAL rung count; adjust_beta grows the ladder
#                             during phase 1, so start small, e.g. 4)
#   max_iter                 (>= ~30000 so ~300 full-ladder score events accrue)
#   adapt_beta_every         (period of the logL statistics window in phase 1,
#                             e.g. 256: how often the statistics the adaptation
#                             step reads are restarted. It stopped being the
#                             rate of adaptation on 2026-09-08, when that became
#                             phase1_step_every)
#   phase1_step_every        (iterations between phase-1 adaptation steps, 1 =
#                             one per iteration. This is the ladder's rate of
#                             construction: a step redistributes the rungs and
#                             adds at most one, so phase1_end/phase1_step_every
#                             bounds the whole ladder's travel. 256 left 19 steps
#                             in a 5000-iteration phase 1 and the ladder never
#                             reached beta = 1)
#   adapt_beta_nu, adapt_beta_t0
#                            (the phase-1 gain: kappa(iter) = (1/nu)*t0/(t0+iter)
#                             multiplies each step, so nu scales it and t0 sets
#                             how fast it decays. nu 0.5, t0 3000.)
#   adapt_beta_equalizer     ("deltaBeta_deltaL_vfm": equalize dbeta*dE[logL]
#                             between neighbouring tramos; "Acceptance_vfm":
#                             equalize the measured swap acceptance;
#                             "Acceptance_fixed_vfm": drive every tramo to
#                             desired_acceptance, the published algorithm)
#   desired_acceptance       (target of the _fixed equalizer, e.g. 0.234)
#   adapt_beta_min           (0 pins beta_min, 1 lets it adapt; only the
#                             acceptance-based equalizers are tail-robust
#                             there, see adapt_beta_step)
#   phase1_end, drift_iters, hold_iters, hold_burnin, n_cycles, cycle_gain
#                            (the drift-and-hold ladder schedule, 2026-09-07:
#                             continuous adaptation until phase1_end, then
#                             n_cycles of [hold | one adaptation step of gain
#                             cycle_gain + drift settling], then a permanent
#                             hold. The telescopic evidence pools only inside
#                             holds, after hold_burnin iterations; each hold is
#                             an independent estimate of log Z. Values from
#                             tau_int(logL) ~ 34 iterations at the cold rungs:
#                             drift 300, hold_burnin 100, hold 3000.)
#   max_values               (max_number_of_values_per_iteration; 128 makes the
#                             score saver land every ~110 iterations, ~8% cost)
#   seed_cco, seed_coc       (nonzero; 0 means random_device)

experiment = create_experiment(
   experiment_structure = [
      {exp_n_step_1, exp_n_samp, 0.0},
      {exp_n_step_2, exp_n_samp, agonist_2},
      {exp_n_step_3, exp_n_samp, agonist_3}],
   frequency_of_sampling = 50e3,
   initial_agonist = 0.0,
   initial_time = 0.0)

likelihood_algorithm = set_Likelihood_algorithm(
   adaptive_aproximation = 0, recursive_approximation = 1,
   averaging_approximation = 2, variance_correction_approximation = 0,
   variance_approximation = 1, n_sub_dt = 1000)

thermo_algorithm_dts = set_ThermoAlgorithm_dts(
   num_scouts_per_ensemble = num_scouts,
   number_trials_until_give_up = 100000,
   max_iter_equilibrium = max_iter,
   beta_size = beta_size,
   thermo_jumps_every = 1,
   save_every_param_size_factor = 1,
   adapt_beta_every = adapt_beta_every,
   adapt_beta_equalizer = adapt_beta_equalizer,
   adapt_beta_controler = "s",
   adapt_beta_variance = "variance",
   adapt_beta_nu = adapt_beta_nu,
   adapt_beta_t0 = adapt_beta_t0,
   adjust_beta = 1,
   acceptance_upper_limit = 1.95,
   acceptance_lower_limit = 0.25,
   desired_acceptance = desired_acceptance)

# The DSL matches arguments BY POSITION even though they are written by name:
# this list must follow the declaration order of set_Ladder_schedule
# (CLI_thermo_evidence_dts.h), or the run dies at parse time saying it expected
# one id and found the next.
ladder_schedule = set_Ladder_schedule(
   phase1_end = phase1_end, drift = drift_iters, hold = hold_iters,
   hold_burnin = hold_burnin, n_cycles = n_cycles, cycle_gain = cycle_gain,
   adapt_beta_min = adapt_beta_min, phase1_step_every = phase1_step_every)

thermo_evidence_dts(idname = idname_cco, model = "scheme_CCO",
   prior = prior_cco_file, likelihood_algorithm = likelihood_algorithm,
   data = observations_file, experiment = experiment,
   thermo_algorithm = thermo_algorithm_dts, ladder_schedule = ladder_schedule,
   sampling_interval = 1,
   max_number_of_values_per_iteration = max_values, init_seed = seed_cco)

thermo_evidence_dts(idname = idname_coc, model = "scheme_COC",
   prior = prior_coc_file, likelihood_algorithm = likelihood_algorithm,
   data = observations_file, experiment = experiment,
   thermo_algorithm = thermo_algorithm_dts, ladder_schedule = ladder_schedule,
   sampling_interval = 1,
   max_number_of_values_per_iteration = max_values, init_seed = seed_coc)
